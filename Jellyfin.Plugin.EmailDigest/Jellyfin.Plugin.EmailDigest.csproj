<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.EmailDigest</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.EmailDigest</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <!-- Copy MailKit and its dependencies next to the plugin DLL so they can be deployed with it. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Pinned to the exact Jellyfin server version this plugin is built and tested against
      (10.11.8). Per the official plugin template guidance, the package version must match
      the installed server version or the plugin will be reported as "NotSupported" by the
      dashboard. Bump deliberately when moving to a newer 10.11.x patch, and re-verify against
      a live server before raising it.
    -->
    <PackageReference Include="Jellyfin.Controller" Version="10.11.8">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="10.11.8">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- ASP.NET Core types for the administrator API controller. Provided by the server at runtime. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!--
      SMTP client and MIME builder. Not part of Jellyfin, so its assemblies (MailKit, MimeKit,
      BouncyCastle.Cryptography) must be deployed next to the plugin DLL, unlike the Jellyfin
      packages above whose runtime assets are excluded because the server provides them.
    -->
    <PackageReference Include="MailKit" Version="4.16.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SerilogAnalyzer" Version="0.15.0" PrivateAssets="All" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="All" />
    <PackageReference Include="SmartAnalyzers.MultithreadingAnalyzer" Version="1.1.31" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the tests inject a certificate validator for a local fake SMTP server. -->
    <InternalsVisibleTo Include="Jellyfin.Plugin.EmailDigest.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
    <None Remove="Localization\en.json" />
    <EmbeddedResource Include="Localization\en.json" />
    <None Remove="Localization\es.json" />
    <EmbeddedResource Include="Localization\es.json" />
    <None Remove="Localization\gl.json" />
    <EmbeddedResource Include="Localization\gl.json" />
  </ItemGroup>

</Project>
